      h += chip('unmarked', 'Not marked', p.filter(function (i) { return !i.outcome; }).length, outFilter, 'ochip');
      h += chip('used', 'Used', p.filter(function (i) { return i.outcome === 'used'; }).length, outFilter, 'ochip');
      h += chip('unused', 'Unused', p.filter(function (i) { return i.outcome === 'unused'; }).length, outFilter, 'ochip');
    }
    box.innerHTML = h;
  }
  function passFilter(it) {
    if (filter === 'all') return true;
    if (filter === 'suggested') return !!it.suggested;
    if (it.suggested) return false;
    if (filter === 'todo') return !it.packed;
    return !it.packed && it.flag === filter;
  }
  function packMain() {
    var h = '';
    S.kits.forEach(function (k) {
      var all = S.items.filter(function (i) { return i.kit === k.id; });
      var vis = all.filter(passFilter);
      if (filter !== 'all' && !vis.length) return;
      var rl = all.filter(function (i) { return !i.suggested; });
      var done = rl.filter(function (i) { return i.packed; }).length;
      var pct = rl.length ? Math.round(done * 100 / rl.length) : 0;
      var col = ui.collapsed[k.id] && filter === 'all';
      h += '<section class="kit" aria-label="' + esc(k.name) + '"><div class="kit-h">' +
        '<button class="kit-t" data-act="kitToggle" data-kit="' + k.id + '" aria-expanded="' + (col ? 'false' : 'true') + '">' +
        '<span class="plate">' + esc(k.code) + '</span><span class="kt"><b>' + esc(k.name) + '</b><small>' + esc(k.where || 'No location set') + '</small></span>' +
        '<span class="cnt' + (rl.length && done === rl.length ? ' full' : '') + '">' + done + '/' + rl.length + '</span></button>' +
        '<button class="mini" data-act="kitEdit" data-kit="' + k.id + '" aria-label="Edit kit ' + esc(k.name) + '">Edit</button></div>' +
        '<div class="kbar"><i style="width:' + pct + '%"></i></div>';
      if (!col) {
        h += '<ul class="list">' + vis.map(function (i) { return itemRow(i, false); }).join('') + '</ul>';
        if (k.note && filter === 'all') h += '<p class="knote">' + esc(k.note) + '</p>';
        if (filter === 'all') {
          h += '<form class="add" data-kit="' + k.id + '"><label class="sr" for="add-' + k.id + '">Add an item to ' + esc(k.name) + '</label>' +
            '<input id="add-' + k.id + '" type="text" placeholder="Add item to ' + esc(k.code) + '" autocomplete="off" enterkeyhint="done"><button class="btn" type="submit">Add</button></form>';
        }
      }
      h += '</section>';
    });
    if (!h) h = '<div class="empty"><b>Nothing here</b>No items match this filter.</div>';
    if (filter === 'all') {
      var np = real().filter(function (i) { return i.packed; }).length;
      h += '<div class="actions" style="justify-content:flex-start"><button class="btn ghost" data-act="newKit">+ New kit</button>' +
        '<button class="btn ghost" data-act="resetTicks"' + (np ? '' : ' disabled') + '>' +
        (ui.confirm === 'resetTicks' ? 'Tap again to untick all ' + np : 'Reset all ticks') + '</button>' +
        '<button class="btn ghost" data-act="backup">Save backup</button><button class="btn ghost" data-act="restore">Restore backup</button></div>';
    }
    return h;
  }
  function searchMain() {
    var terms = q.toLowerCase().split(/\s+/).filter(Boolean);
    var res = S.items.filter(function (it) {
      var k = kitById(it.kit) || {};
      var hay = (it.name + ' ' + (it.note || '') + ' ' + (k.name || '') + ' ' + (k.where || '') + ' ' + (k.code || '')).toLowerCase();
      return terms.every(function (t) { return hay.indexOf(t) > -1; });
    });
    var h = '<p class="hint">' + res.length + ' match' + (res.length === 1 ? '' : 'es') + ' for “' + esc(q.trim()) + '”</p>';
    if (res.length) {
      h += '<div class="kit"><ul class="list">' + res.map(function (i) { return itemRow(i, true); }).join('') + '</ul></div>';
    } else {
      var opts = S.kits.map(function (k) { return '<option value="' + k.id + '">' + esc(k.code + ' · ' + k.name) + '</option>'; }).join('');
      h += '<form class="panel-card" id="qadd"><div class="field"><label for="qadd-kit">Add “' + esc(q.trim()) + '” to a kit</label><select id="qadd-kit">' + opts + '</select></div><button class="btn" type="submit">Add item</button></form>';
    }
    return h;
  }
  function labelsMain() {
    var h = '<p class="hint">One label per kit. Save the sheet, open the file and print it, then stick each label on its kit. Edit a kit on the Pack tab and the label follows.</p>' +
      '<div class="actions" style="justify-content:flex-start"><button class="btn" data-act="saveLabels">Save printable labels</button></div><div class="labels">';
    S.kits.forEach(function (k) {
      var its = S.items.filter(function (i) { return i.kit === k.id && !i.suggested && i.who === 'me'; });
      h += '<article class="label"><div class="label-h"><span class="plate">' + esc(k.code) + '</span><b>' + esc(k.name) + '</b></div>' +
        '<small>' + esc(k.where || 'No location set') + ' · ' + its.length + ' items</small>' +
        '<ul>' + its.map(function (i) { return '<li>' + esc(i.name) + (i.qty ? ' (' + esc(i.qty) + ')' : '') + '</li>'; }).join('') + '</ul>' +
        '<div class="label-f"><button class="btn sm ghost" data-act="copyKit" data-kit="' + k.id + '" style="color:#0B6E78;border-color:#9fb3b1">Copy list</button></div></article>';
    });
    return h + '</div>';
  }
  function afterMain() {
    var r = real(), p = r.filter(function (i) { return i.packed; });
    var used = p.filter(function (i) { return i.outcome === 'used'; });
    var unused = p.filter(function (i) { return i.outcome === 'unused'; });
    var h = '<div class="tiles">' +
      '<div class="tile used"><b>' + used.length + '</b><span>Used</span></div>' +
      '<div class="tile"><b>' + unused.length + '</b><span>Came back unused</span></div>' +
      '<div class="tile"><b>' + (p.length - used.length - unused.length) + '</b><span>Not marked yet</span></div>' +
      '<div class="tile"><b>' + (r.length - p.length) + '</b><span>Never packed</span></div></div>' +
      '<p class="hint">After the trip, mark each packed item as used or unused. Items that never got ticked as packed stay out of this list.</p>';
    var any = false;
    S.kits.forEach(function (k) {
      var its = p.filter(function (i) {
        if (i.kit !== k.id) return false;
        if (outFilter === 'unmarked') return !i.outcome;
        if (outFilter === 'used' || outFilter === 'unused') return i.outcome === outFilter;
        return true;
      });
      if (!its.length) return;
      any = true;
      h += '<section class="kit"><div class="kit-h"><div class="kit-t" style="cursor:default"><span class="plate">' + esc(k.code) + '</span><span class="kt"><b>' + esc(k.name) + '</b></span></div></div><ul class="list">';
      its.forEach(function (i) {
        h += '<li class="item rev"><span class="ibody"><span class="nm">' + esc(i.name) + (i.qty ? ' · ' + esc(i.qty) : '') + '</span>' +
          (i.critical ? '<span class="sub">Must carry</span>' : '') + '</span>' +
          '<span class="seg" role="group" aria-label="Outcome for ' + esc(i.name) + '">' +
          '<button class="u" data-act="out" data-v="used" data-id="' + i.id + '" aria-pressed="' + (i.outcome === 'used') + '">Used</button>' +
          '<button class="n" data-act="out" data-v="unused" data-id="' + i.id + '" aria-pressed="' + (i.outcome === 'unused') + '">Unused</button></span></li>';
      });
      h += '</ul></section>';
    });
    if (!any) h += '<div class="empty"><b>Nothing to review</b>' + (p.length ? 'No packed items match this filter.' : 'Tick items as packed on the Pack tab and they show up here.') + '</div>';
    if (used.length + unused.length) {
      var keep = unused.filter(function (i) { return i.critical; }), drop = unused.filter(function (i) { return !i.critical; });
      function names(a) { return a.length ? esc(a.map(function (i) { return i.name; }).join(', ')) : 'None'; }
      h += '<div class="panel-card"><h2>Next 4–5 day trip</h2>' +
        '<div class="verdict"><h3>Carry again (used)</h3><p>' + names(used) + '</p></div>' +
        '<div class="verdict"><h3>Keep as insurance (unused, must carry)</h3><p>' + names(keep) + '</p></div>' +
        '<div class="verdict"><h3>Consider leaving behind (unused)</h3><p>' + names(drop) + '</p></div></div>';
    }
    var nm2 = used.length + unused.length, left = p.length - nm2;
    if (left) {
      h += '<div class="panel-card"><p class="hint">Quicker way: tap Used only on what you actually used. Then mark everything left as unused in one tap.</p>' +
        '<div class="actions" style="justify-content:flex-start"><button class="btn" data-act="markRest">' +
        (ui.confirm === 'markRest' ? 'Tap again to mark ' + left + ' as unused' : 'Mark the remaining ' + left + ' as unused') + '</button></div></div>';
    }
    h += '<div class="actions" style="justify-content:flex-start"><button class="btn" data-act="saveCsv">Save trip record (.csv)</button>' +
      '<button class="btn ghost" data-act="clearMarks"' + (nm2 ? '' : ' disabled') + '>' +
      (ui.confirm === 'clearMarks' ? 'Tap again to clear ' + nm2 + ' marks' : 'Clear used / unused marks') + '</button></div>';
    return h;
  }

  /* ---------- sheets ---------- */
  function openSheet(html) {
    $('#sheet').innerHTML = html;
    $('#overlay').hidden = false;
    var f = $('#sheet input, #sheet textarea, #sheet select');
    if (f) setTimeout(function () { try { f.focus(); } catch (e) {} }, 30);
  }
  function closeSheet() {
    $('#overlay').hidden = true;
    $('#sheet').innerHTML = '';
    ui.editId = null; ui.kitEditId = null; ui.confirmDel = false;
  }
  function opts(map, cur) {
    return Object.keys(map).map(function (k) { return '<option value="' + k + '"' + (k === cur ? ' selected' : '') + '>' + esc(map[k]) + '</option>'; }).join('');
  }
  function editItem(id) {
    var it = itemById(id);
    if (!it) return;
    ui.editId = id; ui.confirmDel = false;
    var kitOpts = S.kits.map(function (k) { return '<option value="' + k.id + '"' + (k.id === it.kit ? ' selected' : '') + '>' + esc(k.code + ' · ' + k.name) + '</option>'; }).join('');
    var flagMap = { '': 'None' }; Object.keys(FLAGS).forEach(function (k) { flagMap[k] = FLAGS[k]; });
    openSheet('<h2 id="sheet-title">Edit item</h2>' +
      '<div class="field"><label for="f-name">Item</label><input id="f-name" type="text" value="' + esc(it.name) + '"></div>' +
      '<div class="two"><div class="field"><label for="f-qty">Quantity</label><input id="f-qty" type="text" value="' + esc(it.qty) + '" placeholder="e.g. 3 pairs"></div>' +
      '<div class="field"><label for="f-kit">Kit</label><select id="f-kit">' + kitOpts + '</select></div></div>' +
      '<div class="two"><div class="field"><label for="f-who">Who brings it</label><select id="f-who">' + opts(WHO, it.who || 'me') + '</select></div>' +
      '<div class="field"><label for="f-flag">Flag</label><select id="f-flag">' + opts(flagMap, it.flag || '') + '</select></div></div>' +
      '<div class="field"><label for="f-note">Note</label><textarea id="f-note">' + esc(it.note) + '</textarea></div>' +
      '<div class="checks"><label><input id="f-star" type="checkbox"' + (it.star ? ' checked' : '') + '>Starred</label>' +
      '<label><input id="f-crit" type="checkbox"' + (it.critical ? ' checked' : '') + '>Must carry (insurance)</label></div>' +
      '<div class="actions"><button class="btn danger sm" data-act="delItem" id="b-del">Delete</button><span class="spacer"></span>' +
      '<button class="btn ghost sm" data-act="closeSheet">Cancel</button><button class="btn sm" data-act="saveItem">Save</button></div>');
  }
  function editKit(id) {
    var k = id ? kitById(id) : null;
    ui.kitEditId = id || 'new'; ui.confirmDel = false;
    openSheet('<h2 id="sheet-title">' + (k ? 'Edit kit' : 'New kit') + '</h2>' +
      '<div class="field"><label for="k-name">Kit name</label><input id="k-name" type="text" value="' + esc(k ? k.name : '') + '"></div>' +
      '<div class="two"><div class="field"><label for="k-code">Label code</label><input id="k-code" type="text" maxlength="4" value="' + esc(k ? k.code : '') + '" placeholder="e.g. MED"></div>' +
      '<div class="field"><label for="k-where">Travels in</label><input id="k-where" type="text" value="' + esc(k ? k.where : '') + '" placeholder="e.g. Support SUV"></div></div>' +
      '<div class="field"><label for="k-note">Kit note</label><textarea id="k-note">' + esc(k ? k.note : '') + '</textarea></div>' +
      '<div class="actions">' + (k ? '<button class="btn danger sm" data-act="delKit" id="b-del">Delete kit</button>' : '') + '<span class="spacer"></span>' +
      '<button class="btn ghost sm" data-act="closeSheet">Cancel</button><button class="btn sm" data-act="saveKit">Save</button></div>');
  }

  /* ---------- export ---------- */
  function kitText(k) {
    var its = S.items.filter(function (i) { return i.kit === k.id && !i.suggested && i.who === 'me'; });
    return k.code + ' · ' + k.name + (k.where ? ' (' + k.where + ')' : '') + '\n' +
      its.map(function (i) { return '[ ] ' + i.name + (i.qty ? ' (' + i.qty + ')' : ''); }).join('\n');
  }
  function labelsHtml() {
    var cards = S.kits.map(function (k) {
      var its = S.items.filter(function (i) { return i.kit === k.id && !i.suggested && i.who === 'me'; });
      return '<div class="l"><div class="h"><span class="p">' + esc(k.code) + '</span><b>' + esc(k.name) + '</b></div><div class="w">' +
        esc(k.where || '') + '</div><ul>' + its.map(function (i) { return '<li>' + esc(i.name) + (i.qty ? ' (' + esc(i.qty) + ')' : '') + '</li>'; }).join('') + '</ul></div>';
    }).join('');
    return '<!doctype html><html lang="en"><head><meta charset="utf-8"><title>Kit labels</title><style>' +
      '@page{size:A4;margin:10mm}body{font-family:Arial,Helvetica,sans-serif;margin:0;color:#111}' +
      '.g{display:grid;grid-template-columns:repeat(2,1fr);gap:6mm}' +
      '.l{border:1.5pt solid #111;border-radius:2mm;padding:4mm;break-inside:avoid;min-height:55mm}' +
      '.h{display:flex;align-items:center;gap:3mm}.p{background:#F2B705;padding:1mm 3mm;font:bold 16pt monospace;border-radius:1mm}' +
      '.h b{font-size:15pt;text-transform:uppercase}.w{font-size:9pt;color:#444;margin:1mm 0 2mm}' +
      'ul{list-style:none;margin:0;padding:0;columns:2;column-gap:4mm;font-size:9.5pt}' +
      'li{padding:.5mm 0;break-inside:avoid}li:before{content:"\\2610  "}' +
      '</style></head><body><div class="g">' + cards + '</div></body></html>';
  }
  function csvq(v) { v = String(v == null ? '' : v); return /[",\n]/.test(v) ? '"' + v.replace(/"/g, '""') + '"' : v; }
  function recordCsv() {
    var rows = [['Kit', 'Item', 'Quantity', 'Who brings', 'Must carry', 'Packed', 'Outcome', 'Note']];
    S.items.filter(function (i) { return !i.suggested; }).forEach(function (i) {
      var k = kitById(i.kit) || { name: '' };
      rows.push([k.name, i.name, i.qty, WHO[i.who] || i.who, i.critical ? 'yes' : '', i.packed ? 'yes' : 'no', i.outcome || '', i.note]);
    });
    return rows.map(function (r) { return r.map(csvq).join(','); }).join('\n');
  }
  function save(filename, data) {
    try {
      var type = /\.csv$/.test(filename) ? 'text/csv' : /\.json$/.test(filename) ? 'application/json' : 'text/html';
      var url = URL.createObjectURL(new Blob([data], { type: type + ';charset=utf-8' }));
      var a = document.createElement('a');
      a.href = url; a.download = filename;
      document.body.appendChild(a); a.click();
      setTimeout(function () { URL.revokeObjectURL(url); a.remove(); }, 1000);
      toast('Saved ' + filename);
    } catch (e) { toast('Could not save the file.'); }
  }
  function copyText(text) {
    var done = function () { toast('Copied'); };
    var fallback = function () {
      openSheet('<h2 id="sheet-title">Copy this list</h2><textarea class="copybox" id="copybox" readonly>' + esc(text) + '</textarea><div class="actions"><button class="btn sm" data-act="closeSheet">Done</button></div>');
      var t = $('#copybox'); if (t) { t.focus(); t.select(); }
    };
    try { navigator.clipboard.writeText(text).then(done, fallback); } catch (e) { fallback(); }
  }

  /* ---------- actions ---------- */
  function addItem(kitId, name) {
    name = (name || '').trim();
    if (!name) return false;
    S.items.push({ id: uid('i'), kit: kitId, name: name, qty: '', note: '', who: 'me', flag: '', star: false, critical: false, packed: false, outcome: '', suggested: false });
    commit();
    return true;
  }
  document.addEventListener('click', function (e) {
    var b = e.target.closest('[data-act]');
    if (!b) return;
    var act = b.getAttribute('data-act'), id = b.getAttribute('data-id'), it;
    if (act === 'tab') {
      tab = b.getAttribute('data-tab'); ui.confirm = ''; lsSet(TABKEY, tab); render(); return;
    }
    if (!S) return;
    if (act !== 'resetTicks' && act !== 'clearMarks' && act !== 'markRest' && ui.confirm) { ui.confirm = ''; if (act === 'tab') render(); }
    switch (act) {
      case 'markRest':
        if (ui.confirm !== act) { ui.confirm = act; render(); break; }
        ui.confirm = '';
        S.items.forEach(function (i) { if (!i.suggested && i.packed && !i.outcome) i.outcome = 'unused'; });
        commit();
        toast('Remaining items marked unused');
        break;
      case 'resetTicks':
      case 'clearMarks':
        if (ui.confirm !== act) { ui.confirm = act; render(); break; }
        ui.confirm = '';
        S.items.forEach(function (i) {
          if (act === 'resetTicks') { i.packed = false; i.outcome = ''; } else { i.outcome = ''; }
        });
        commit();
        toast(act === 'resetTicks' ? 'All ticks reset' : 'Marks cleared');
        break;
      case 'chip': filter = b.getAttribute('data-f'); render(); break;
      case 'ochip': outFilter = b.getAttribute('data-f'); render(); break;
      case 'toggle':
        it = itemById(id); if (!it) break;
        it.packed = !it.packed;
        if (!it.packed) it.outcome = '';
        commit(); break;
      case 'edit': editItem(id); break;
      case 'accept': it = itemById(id); if (it) { it.suggested = false; commit(); toast('Added to ' + (kitById(it.kit) || {}).code); } break;
      case 'dismiss': S.items = S.items.filter(function (i) { return i.id !== id; }); commit(); break;
      case 'kitToggle': var kid = b.getAttribute('data-kit'); ui.collapsed[kid] = !ui.collapsed[kid]; render(); break;
      case 'kitEdit': editKit(b.getAttribute('data-kit')); break;
      case 'newKit': editKit(null); break;
      case 'out':
        it = itemById(id); if (!it) break;
        var v = b.getAttribute('data-v');
        it.outcome = it.outcome === v ? '' : v;
        commit(); break;
      case 'closeSheet': closeSheet(); break;
      case 'saveItem':
        it = itemById(ui.editId); if (!it) { closeSheet(); break; }
        var nm = $('#f-name').value.trim();
        if (!nm) { toast('Give the item a name.'); break; }
        it.name = nm; it.qty = $('#f-qty').value.trim(); it.kit = $('#f-kit').value;
        it.who = $('#f-who').value; it.flag = $('#f-flag').value; it.note = $('#f-note').value.trim();
        it.star = $('#f-star').checked; it.critical = $('#f-crit').checked;
        closeSheet(); commit(); break;
      case 'delItem':
        if (!ui.confirmDel) { ui.confirmDel = true; b.textContent = 'Tap again to delete'; break; }
        S.items = S.items.filter(function (i) { return i.id !== ui.editId; });
        closeSheet(); commit(); break;
      case 'saveKit':
        var kn = $('#k-name').value.trim(), kc = $('#k-code').value.trim().toUpperCase();
        if (!kn) { toast('Give the kit a name.'); break; }
        if (!kc) kc = kn.slice(0, 3).toUpperCase();
        if (ui.kitEditId === 'new') {
          S.kits.push({ id: uid('k'), code: kc, name: kn, where: $('#k-where').value.trim(), note: $('#k-note').value.trim() });
        } else {
          var k = kitById(ui.kitEditId);
          if (k) { k.name = kn; k.code = kc; k.where = $('#k-where').value.trim(); k.note = $('#k-note').value.trim(); }
        }
        closeSheet(); commit(); break;
      case 'delKit':
        var has = S.items.some(function (i) { return i.kit === ui.kitEditId; });
        if (has) { toast('Move or delete this kit’s items first.'); break; }
        if (!ui.confirmDel) { ui.confirmDel = true; b.textContent = 'Tap again to delete'; break; }
        S.kits = S.kits.filter(function (k2) { return k2.id !== ui.kitEditId; });
        closeSheet(); commit(); break;
      case 'backup': save('leh-packing-backup.json', JSON.stringify(S, null, 1)); break;
      case 'restore': $('#restoreFile').click(); break;
      case 'copyKit': var kk = kitById(b.getAttribute('data-kit')); if (kk) copyText(kitText(kk)); break;
      case 'saveLabels': save('leh-ladakh-kit-labels.html', labelsHtml()); break;
      case 'saveCsv': save('leh-ladakh-trip-record.csv', recordCsv()); break;
    }
  });
  document.addEventListener('submit', function (e) {
    var f = e.target;
    if (!S) return;
    if (f.classList.contains('add')) {
      e.preventDefault();
      var kid = f.getAttribute('data-kit'), inp = f.querySelector('input');
      if (addItem(kid, inp.value)) {
        var again = document.getElementById('add-' + kid);
        if (again) again.focus();
      }
    } else if (f.id === 'qadd') {
      e.preventDefault();
      if (addItem($('#qadd-kit').value, q)) { q = ''; $('#q').value = ''; render(); toast('Added'); }
    }
  });
  $('#q').addEventListener('input', function (e) { q = e.target.value; if (S) render(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !$('#overlay').hidden) closeSheet(); });
  $('#overlay').addEventListener('click', function (e) { if (e.target === $('#overlay')) closeSheet(); });

  /* ---------- boot ---------- */
  loadLocal();
  setSync('local');
  render();
  $('#restoreFile').addEventListener('change', function (e) {
    var f = e.target.files && e.target.files[0];
    if (!f) return;
    var r = new FileReader();
    r.onload = function () {
      try {
        var o = JSON.parse(r.result);
        if (!o || !Array.isArray(o.kits) || !Array.isArray(o.items)) throw new Error('bad');
        S = o; commit(); toast('Backup restored');
      } catch (err) { toast('That file is not a packing backup.'); }
      e.target.value = '';
    };
    r.readAsText(f);
  });
})();
</script>
</body>
</html>
