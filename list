<style>
/* Layout: one narrow column built for a phone in a gloved hand. Kits are cards with a yellow route-board code plate; the plate is the label you print and stick on the kit. */
:root {
  --bg: #EAEFEE;
  --surface: #FFFFFF;
  --surface2: #F2F6F5;
  --ink: #14272B;
  --muted: #53686C;
  --line: #CCD8D6;
  --accent: #0B6E78;
  --accent-ink: #FFFFFF;
  --plate: #F2B705;
  --plate-ink: #1B1A12;
  --buy: #A8480F;
  --today: #B3261E;
  --decide: #5E45A0;
  --pending: #7A5C00;
  --ok: #1E7A46;
  --shadow: rgba(20, 39, 43, .10);
  --f-display: 'Barlow Condensed', 'Arial Narrow', system-ui, sans-serif;
  --f-body: 'Barlow', system-ui, -apple-system, 'Segoe UI', sans-serif;
  --f-mono: 'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0E1A1D; --surface: #162529; --surface2: #1B2E33; --ink: #E4EEED; --muted: #98ADB0;
    --line: #2B4247; --accent: #4CC3CE; --accent-ink: #06262A; --plate: #F2B705; --plate-ink: #1B1A12;
    --buy: #F0925A; --today: #FF8A80; --decide: #B9A4F2; --pending: #E3BE4B; --ok: #5FD08A;
    --shadow: rgba(0, 0, 0, .35); color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #0E1A1D; --surface: #162529; --surface2: #1B2E33; --ink: #E4EEED; --muted: #98ADB0;
  --line: #2B4247; --accent: #4CC3CE; --accent-ink: #06262A; --plate: #F2B705; --plate-ink: #1B1A12;
  --buy: #F0925A; --today: #FF8A80; --decide: #B9A4F2; --pending: #E3BE4B; --ok: #5FD08A;
  --shadow: rgba(0, 0, 0, .35); color-scheme: dark;
}
* { box-sizing: border-box; }
body { background: var(--bg); color: var(--ink); font: 400 15px/1.45 var(--f-body); padding-inline: 16px; }
.wrap { max-width: 760px; margin-inline: auto; padding-block: 18px 96px; }
button, input, select, textarea { font: inherit; color: inherit; }
button { cursor: pointer; }
:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

/* Header */
.top-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
.eyebrow { margin: 0 0 4px; font: 600 12px/1.2 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
h1 { margin: 0; font: 700 clamp(30px, 8vw, 44px)/1 var(--f-display); text-transform: uppercase; letter-spacing: .01em; text-wrap: balance; }
.sync { flex: none; margin-top: 2px; font: 500 11px/1.3 var(--f-mono); color: var(--muted); text-align: right; max-width: 11em; }
.sync.err { color: var(--today); }
.prog { margin-top: 16px; }
.prog-nums { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
.prog-nums b { font: 700 34px/1 var(--f-display); font-variant-numeric: tabular-nums; }
.prog-nums span { color: var(--muted); font-variant-numeric: tabular-nums; }
.bar { height: 8px; margin-top: 8px; background: var(--line); border-radius: 4px; overflow: hidden; }
.bar i { display: block; height: 100%; background: var(--accent); border-radius: 4px; transition: width .25s ease; }

/* Tabs */
.tabs { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 5; display: flex; gap: 4px; margin-top: 14px; padding-block: 6px 0; background: var(--bg); border-bottom: 1px solid var(--line); }
.tab { flex: 1; min-height: 46px; padding: 0 8px; background: none; border: 0; border-bottom: 4px solid transparent; font: 600 19px/1 var(--f-display); letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
.tab[aria-selected="true"] { color: var(--ink); border-bottom-color: var(--accent); }

/* Search and chips */
.search { margin-top: 14px; }
.search input { width: 100%; min-height: 48px; padding: 0 14px; font-size: 16px; background: var(--surface); border: 1.5px solid var(--line); border-radius: 8px; }
.chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
.chip { min-height: 38px; padding: 0 12px; background: var(--surface); border: 1.5px solid var(--line); border-radius: 8px; font-weight: 500; font-variant-numeric: tabular-nums; }
.chip[aria-pressed="true"] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
.chip .n { margin-left: 6px; opacity: .7; }

/* Kits */
main { margin-top: 14px; display: flex; flex-direction: column; gap: 14px; min-width: 0; }
.kit { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; box-shadow: 0 1px 2px var(--shadow); overflow: hidden; }
.kit-h { display: flex; align-items: stretch; }
.kit-t { flex: 1; min-width: 0; display: flex; align-items: center; gap: 12px; padding: 12px 8px 12px 12px; background: none; border: 0; text-align: left; }
.plate { flex: none; min-width: 3.1em; padding: 3px 8px; text-align: center; background: var(--plate); color: var(--plate-ink); border-radius: 4px; font: 600 15px/1.3 var(--f-mono); letter-spacing: .04em; }
.kt { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.kt b { font: 600 22px/1.1 var(--f-display); text-transform: uppercase; letter-spacing: .02em; overflow-wrap: anywhere; }
.kt small { color: var(--muted); font-size: 13px; }
.cnt { flex: none; font: 600 14px/1 var(--f-mono); font-variant-numeric: tabular-nums; color: var(--muted); }
.cnt.full { color: var(--ok); }
.mini { flex: none; align-self: center; min-height: 40px; margin-right: 8px; padding: 0 10px; background: none; border: 0; color: var(--accent); font-weight: 600; }
.kbar { height: 3px; background: var(--line); }
.kbar i { display: block; height: 100%; background: var(--ok); }
.knote { margin: 0; padding: 8px 14px 10px; font-size: 13px; color: var(--muted); border-top: 1px solid var(--line); }
ul.list { list-style: none; margin: 0; padding: 0; }
.item { display: flex; align-items: center; gap: 2px; padding: 2px 12px 2px 2px; border-top: 1px solid var(--line); }
.chk { flex: none; width: 48px; height: 48px; display: grid; place-items: center; background: none; border: 0; }
.box { width: 26px; height: 26px; display: grid; place-items: center; border: 2px solid var(--muted); border-radius: 6px; color: var(--accent-ink); }
.box svg { opacity: 0; }
.chk[aria-checked="true"] .box { background: var(--accent); border-color: var(--accent); }
.chk[aria-checked="true"] .box svg { opacity: 1; }
.ibody { flex: 1; min-width: 0; min-height: 48px; padding: 6px 4px; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 2px; background: none; border: 0; text-align: left; }
.nm { font-weight: 500; font-size: 16px; overflow-wrap: anywhere; }
.sub { font-size: 13px; color: var(--muted); overflow-wrap: anywhere; }
.item.done .nm { color: var(--muted); text-decoration: line-through; text-decoration-thickness: 1.5px; }
.tags { flex: none; display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 4px; max-width: 42%; }
.tag { padding: 1px 7px; border-radius: 4px; font: 600 11px/1.5 var(--f-mono); letter-spacing: .04em; text-transform: uppercase; white-space: nowrap; border: 1px solid currentColor; }
.tag.buy { color: var(--buy); background: color-mix(in srgb, var(--buy) 12%, transparent); }
.tag.today { color: var(--today); background: color-mix(in srgb, var(--today) 12%, transparent); }
.tag.decide { color: var(--decide); background: color-mix(in srgb, var(--decide) 12%, transparent); }
.tag.pending { color: var(--pending); background: color-mix(in srgb, var(--pending) 14%, transparent); }
.tag.who { color: var(--muted); }
.tag.must { color: var(--ok); }
.tag.qty { color: var(--ink); border-color: var(--line); }
.tag.star { color: var(--pending); border-color: transparent; padding-inline: 2px; font-size: 14px; }
.item.sugg { background: var(--surface2); border-top-style: dashed; padding-left: 14px; gap: 8px; flex-wrap: wrap; }
.item.sugg .ibody { cursor: default; }
.sg-act { display: flex; gap: 6px; padding-block: 6px; }
.item.where { padding-left: 12px; }

/* Buttons and forms */
.btn { min-height: 44px; padding: 0 16px; background: var(--accent); color: var(--accent-ink); border: 0; border-radius: 8px; font-weight: 600; }
.btn.ghost { background: transparent; color: var(--accent); border: 1.5px solid var(--line); }
.btn.danger { background: var(--today); color: #fff; }
.btn.sm { min-height: 40px; padding: 0 12px; }
.btn[disabled] { opacity: .45; cursor: default; }
.add { display: flex; gap: 8px; padding: 10px 12px 12px; border-top: 1px solid var(--line); }
.add input, .field input, .field select, .field textarea { width: 100%; min-height: 44px; padding: 8px 12px; font-size: 16px; background: var(--surface); border: 1.5px solid var(--line); border-radius: 8px; }
.add input { flex: 1; min-width: 0; }
.empty { padding: 28px 16px; text-align: center; color: var(--muted); background: var(--surface); border: 1.5px dashed var(--line); border-radius: 10px; }
.empty b { display: block; margin-bottom: 4px; color: var(--ink); font: 600 22px/1.2 var(--f-display); text-transform: uppercase; }
.hint { margin: 0; color: var(--muted); font-size: 14px; }

/* After trip */
.tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px; }
.tile { padding: 12px 14px; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; }
.tile b { display: block; font: 700 36px/1 var(--f-display); font-variant-numeric: tabular-nums; }
.tile span { font-size: 13px; color: var(--muted); }
.tile.used b { color: var(--ok); }
.seg { flex: none; display: flex; border: 1.5px solid var(--line); border-radius: 8px; overflow: hidden; }
.seg button { min-height: 44px; padding: 0 12px; background: var(--surface); border: 0; font-weight: 600; font-size: 14px; }
.seg button + button { border-left: 1.5px solid var(--line); }
.seg button[aria-pressed="true"].u { background: var(--ok); color: #fff; }
.seg button[aria-pressed="true"].n { background: var(--muted); color: var(--surface); }
.item.rev { padding: 4px 12px; gap: 10px; }
.item.rev .ibody { min-height: 44px; padding-left: 0; cursor: default; }
.panel-card { padding: 14px; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; display: flex; flex-direction: column; gap: 12px; }
.panel-card h2 { margin: 0; font: 600 22px/1.1 var(--f-display); text-transform: uppercase; letter-spacing: .02em; }
.verdict h3 { margin: 0 0 4px; font: 600 13px/1.2 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
.verdict p { margin: 0; overflow-wrap: anywhere; }

/* Labels */
.labels { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px; }
.label { padding: 12px; background: #fff; color: #14272B; border: 2px solid #14272B; border-radius: 6px; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.label-h { display: flex; align-items: center; gap: 10px; }
.label-h .plate { font-size: 20px; padding: 4px 10px; }
.label-h b { font: 700 22px/1.05 var(--f-display); text-transform: uppercase; }
.label small { color: #4a5d60; }
.label ul { margin: 0; padding: 0; list-style: none; font-size: 14px; columns: 1; }
.label li { padding: 2px 0; border-bottom: 1px dotted #b8c5c3; overflow-wrap: anywhere; }
.label li::before { content: "\2610\00a0"; }
.label-f { display: flex; gap: 8px; }

/* Sheet */
.overlay { position: fixed; inset: 0; z-index: 20; display: flex; align-items: flex-end; justify-content: center; background: rgba(8, 20, 22, .55); }
.sheet { width: 100%; max-width: 560px; max-height: 92%; overflow: auto; padding: 18px 16px calc(18px + env(safe-area-inset-bottom, 0px)); background: var(--surface); border-radius: 14px 14px 0 0; display: flex; flex-direction: column; gap: 12px; }
.sheet h2 { margin: 0; font: 700 26px/1.1 var(--f-display); text-transform: uppercase; }
.field { display: flex; flex-direction: column; gap: 4px; }
.field label { font: 600 12px/1.2 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
.field textarea { min-height: 64px; resize: vertical; }
.two { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.checks { display: flex; flex-wrap: wrap; gap: 8px 18px; }
.checks label { display: flex; align-items: center; gap: 8px; min-height: 40px; font-size: 15px; }
.checks input { width: 22px; height: 22px; accent-color: var(--accent); }
.actions { display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; }
.actions .spacer { flex: 1; }
.copybox { width: 100%; min-height: 160px; padding: 10px; font: 500 13px/1.5 var(--f-mono); background: var(--surface2); border: 1.5px solid var(--line); border-radius: 8px; }
.toast { position: fixed; left: 50%; bottom: calc(20px + env(safe-area-inset-bottom, 0px)); transform: translateX(-50%); z-index: 30; max-width: calc(100% - 32px); padding: 10px 16px; background: var(--ink); color: var(--bg); border-radius: 8px; font-weight: 500; }
@media (max-width: 420px) {
  .tags { max-width: 36%; }
  .two { grid-template-columns: 1fr; }
}
@media (prefers-reduced-motion: reduce) { .bar i { transition: none; } }
</style>
<style>
:root { color-scheme: light; }
html { -webkit-text-size-adjust: 100%; }
body { margin: 0; padding-top: env(safe-area-inset-top, 0px); padding-bottom: env(safe-area-inset-bottom, 0px); }
[hidden] { display: none !important; }
.back { display: inline-block; margin-bottom: 10px; color: var(--accent); font-weight: 600; text-decoration: none; }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <a class="back" href="./">&larr; Route card</a>
    <div class="top-row">
      <div>
        <p class="eyebrow" id="countdown">Leh · Ladakh</p>
        <h1>Leh Ladakh trip with support vehicle</h1>
      </div>
      <span class="sync" id="sync" aria-live="polite"></span>
    </div>
    <div class="prog" id="prog"></div>
  </header>

  <div class="tabs" role="tablist" aria-label="Views">
    <button class="tab" role="tab" data-act="tab" data-tab="pack" id="t-pack">Pack</button>
    <button class="tab" role="tab" data-act="tab" data-tab="labels" id="t-labels">Labels</button>
    <button class="tab" role="tab" data-act="tab" data-tab="after" id="t-after">After trip</button>
  </div>

  <div class="search">
    <label class="sr" for="q">Search items and kits</label>
    <input id="q" type="search" placeholder="Where is it? Search any item or kit" autocomplete="off" enterkeyhint="search">
  </div>
  <div class="chips" id="chips"></div>
  <main id="main"></main>
</div>

<div class="overlay" id="overlay" hidden>
  <div class="sheet" id="sheet" role="dialog" aria-modal="true" aria-labelledby="sheet-title"></div>
</div>
<div class="toast" id="toast" role="status" aria-live="polite" hidden></div>
<input type="file" id="restoreFile" accept=".json,application/json" hidden>
